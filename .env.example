# Copy this file to .env. The real .env is ignored by Git.
AGENTIC_CM_ADAPTER=deterministic
AGENTIC_CM_DB=data/agentic_cm.db
# Selected Path Agents run concurrently by default. Use serial for provider
# rate limits, deterministic troubleshooting, or constrained local hardware.
AGENTIC_CM_PATH_EXECUTION_MODE=parallel
AGENTIC_CM_PATH_MAX_CONCURRENCY=4

# For an OpenAI-compatible Chat Completions service, change the adapter above
# to openai-compatible and fill these values.
AGENTIC_CM_LLM_BASE_URL=https://your-provider.example/v1
# Global fallback when an Agent-specific model is not set.
AGENTIC_CM_LLM_MODEL=your-model-id
# Each Agent can use a different model.
# AGENTIC_CM_ORCHESTRATOR_LLM_MODEL=your-planning-model-id
# AGENTIC_CM_PATH_LLM_MODEL=your-path-model-id
# AGENTIC_CM_SYNTHESIS_LLM_MODEL=your-synthesis-model-id
AGENTIC_CM_PATH_MAX_OUTPUT_TOKENS=6000
AGENTIC_CM_SYNTHESIS_MAX_OUTPUT_TOKENS=4000
AGENTIC_CM_LLM_API_KEY=

# Thinking is disabled by default for all three Agents. Each Agent can opt in
# independently and choose its own effort. Supported efforts are minimal, low,
# medium, high, xhigh, and max; an effort is sent only when thinking is enabled.
# AGENTIC_CM_ORCHESTRATOR_THINKING_ENABLED=false
# AGENTIC_CM_ORCHESTRATOR_REASONING_EFFORT=high
# AGENTIC_CM_PATH_THINKING_ENABLED=false
# AGENTIC_CM_PATH_REASONING_EFFORT=high
# AGENTIC_CM_SYNTHESIS_THINKING_ENABLED=false
# AGENTIC_CM_SYNTHESIS_REASONING_EFFORT=high
# Optional global fallbacks:
# AGENTIC_CM_LLM_THINKING_ENABLED=false
# AGENTIC_CM_LLM_REASONING_EFFORT=high

# Optional authentication customization.
# AGENTIC_CM_LLM_API_KEY_HEADER=Authorization
# AGENTIC_CM_LLM_API_KEY_PREFIX=Bearer
